# Copy this file to .env.local for local development and fill in the values.
# .env.local is ignored by git. Never commit real keys.
# On Vercel, set these in Project Settings > Environment Variables instead.

# --- Public (sent to the browser; safe to expose) -------------------------
# Supabase project URL (milestone 2)
NEXT_PUBLIC_SUPABASE_URL=https://gcjnqdlzkjxrhlxkhmyz.supabase.co
# Supabase publishable key, starts with sb_publishable_ (milestone 2)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (never add the NEXT_PUBLIC_ prefix) -----------------------
# Supabase secret key, starts with sb_secret_ (milestone 2)
SUPABASE_SECRET_KEY=
# Google Places API key, restricted to the Places API (milestone 4)
GOOGLE_PLACES_API_KEY=
# Ticketmaster Discovery API key (milestone 4)
TICKETMASTER_API_KEY=
